# "local" runs the pipeline in-process (no Azure needed)
# "azure" sends the payload to the deployed Logic App trigger URL
RUN_MODE=local

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Azure Service Principal
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=RELeadScraperGroup

# Azure mode only — Logic App HTTP trigger URL (get from Azure portal or az CLI)
AZURE_LOGIC_APP_TRIGGER_URL=

# Azure Table Storage — shared memory layer for lead pipeline
# Format: DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# Optional: if not set, table ops are skipped silently
AZURE_STORAGE_CONNECTION_STRING=
