# "local" runs the pipeline in-process (no Azure needed)
# "azure" sends the payload to the deployed Logic App trigger URL
RUN_MODE=local

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Azure Service Principal
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
# Required by every az/deploy target — nothing hardcodes it any more.
AZURE_RESOURCE_GROUP=

# Azure mode only — Logic App HTTP trigger URL (get from Azure portal or az CLI)
AZURE_LOGIC_APP_TRIGGER_URL=

# Resource names the Make targets act on. Defaults shown; set to override.
ADMIN_SWA_NAME=flynest-admin
ADMIN_FUNCAPP_NAME=flynest-admin-api
PUBLIC_SWA_NAME=flynest-public

# Azure Table Storage — shared memory layer for lead pipeline
# Format: DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# Optional: if not set, table ops are skipped silently
AZURE_STORAGE_CONNECTION_STRING=

# ─────────────────────────────────────────────────────────────────────────────
# Public UI (public-ui/) — every value below is a DUMMY placeholder.
# A feature whose config is missing switches itself off and is never
# advertised by GET /api/meta, so a half-filled section is safe.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin. Used to build OAuth redirect URIs and email verification
# links, so it must match the deployed hostname exactly (no trailing slash).
PUBLIC_SITE_URL=https://your-public-app.azurestaticapps.net

# ── Email ────────────────────────────────────────────────────────────────────
# acs | brevo | smtp | off.  Azure has no free tier: ACS Email is $0.25 per
# 1,000. Brevo is 9,000/month free.
NOTIFY_EMAIL_PROVIDER=off
NOTIFY_FROM_NAME=FlyNest Deal Board
NOTIFY_FROM_EMAIL=
# ACS (provider=acs) — from the Communication Services resource
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=DoNotReply@00000000-0000-0000-0000-000000000000.azurecomm.net
# Brevo (provider=brevo)
BREVO_API_KEY=
# SMTP (provider=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Web Push ─────────────────────────────────────────────────────────────────
# Generate a real pair with: make pub-vapid  (never reuse the dummies below).
# PUBLIC is served to browsers on purpose; PRIVATE signs each push and must
# never leave the server — anyone holding it can notify your subscribers.
NOTIFY_WEBPUSH_ENABLED=true
VAPID_PUBLIC_KEY=BExampleDummyPublicKeyReplaceMe0000000000000000000000000000000000000000000000000000000
VAPID_PRIVATE_KEY=ExampleDummyPrivateKeyReplaceMe000000000
VAPID_CONTACT_EMAIL=you@example.com

# ── SMS ──────────────────────────────────────────────────────────────────────
# Off by default: real SMS costs ~$0.01/segment plus $2/mo for the number, and
# US toll-free verification must clear before anything delivers.
NOTIFY_SMS_ENABLED=false
NOTIFY_SMS_PROVIDER=acs
ACS_SMS_FROM_NUMBER=

# ── Social sign-in ───────────────────────────────────────────────────────────
# Redirect URI to register with each provider:
#   {PUBLIC_SITE_URL}/api/auth/oauth/{google|microsoft|facebook}/callback
# Only providers with BOTH id and secret set get a button.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
